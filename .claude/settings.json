{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "effortLevel": "medium",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.pfx)",
      "Read(./**/credentials.json)",
      "Read(./**/secrets.json)",
      "Read(./**/id_rsa*)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)"
    ],
    "allow": [
      "Bash(node bin/cli.mjs vault-sync:*)",
      "Bash(npx souclaude vault-sync:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)"
    ],
    "ask": [
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/declarar-milestone.mjs"
          }
        ]
      }
    ]
  }
}
