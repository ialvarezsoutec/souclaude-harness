# Copiar a .env y completar. .env NUNCA se commitea.
# En produccion los secretos van en el secret manager del cloud provider,
# no en un archivo.

# APP_ENV=development
# LOG_LEVEL=debug

# Ruta local al Vault, SOLO para el runtime de la app si lo necesita.
# Los agentes NO la leen de aca: .claude/settings.json deniega Read(./.env).
# Ellos usan .claude/vault.local.json, que escribe el instalador:
#   npx souclaude upgrade --vault-path <ruta>
# VAULT_PATH=C:/ruta/a/soubunker-vault
